source "https://rubygems.org"

# github-pages pins all gems to the exact versions GitHub Pages runs,
# so local builds match the deployed site.
gem "github-pages", group: :jekyll_plugins

# Faster file watching during `jekyll serve` on macOS.
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
gem "webrick"
